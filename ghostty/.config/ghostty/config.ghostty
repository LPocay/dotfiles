theme = Terminal Prompt
# Keep the original readable font size with the Terminal Prompt colors.
font-size = 17.5
font-family = JetBrainsMono Nerd Font
adjust-cell-height = 11
window-padding-x = 17
window-padding-y = 17
window-padding-balance = false
background-opacity = 1
background-blur = false
cursor-style = underline
cursor-style-blink = false

window-decoration = none

#keybind = ctrl+space>t=new_tab
#keybind = ctrl+space>v=new_split:right
#keybind = ctrl+space>h=new_split:down
#keybind = ctrl+space>z=toggle_split_zoom

#keybind = alt+h=goto_split:left
#keybind = alt+l=goto_split:right
#keybind = alt+k=goto_split:top
#keybind = alt+j=goto_split:bottom
#keybind = alt+]=next_tab
#keybind = alt+[=previous_tab

#keybind = ctrl+left=resize_split:left,10
#keybind = ctrl+right=resize_split:right,10
#keybind = ctrl+up=resize_split:up,10
#keybind = ctrl+down=resize_split:down,10
