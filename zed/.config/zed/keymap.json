[
  {
    "context": "Workspace",
    "bindings": {
      "f5": "debugger::Start",
      "f10": "debugger::StepOver",
      "f11": "debugger::StepInto",
      "f12": "debugger::StepOut"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space": null,
      "ctrl-j": null
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space e": "project_panel::ToggleFocus",
      "space p v": "project_panel::ToggleFocus",
      "space f": "editor::Format",
      "space q": "diagnostics::DeployCurrentFile",
      "space y": "editor::Copy",
      "space shift-y": "editor::Copy",
      "space p": "editor::Paste",
      "space d": "editor::Delete",
      "space s": "buffer_search::DeployReplace",

      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",

      "space s f": "file_finder::Toggle",
      "space s s": "command_palette::Toggle",
      "space s w": "workspace::NewSearch",
      "space s g": "workspace::NewSearch",
      "space s d": "diagnostics::Deploy",
      "space s k": "zed::OpenKeymap",
      "space s c": "command_palette::Toggle",
      "space space": "tab_switcher::Toggle",
      "space /": "buffer_search::Deploy",

      "g d": "editor::GoToDefinition",
      "g r r": "editor::FindAllReferences",
      "g r i": "editor::GoToImplementation",
      "g r t": "editor::GoToTypeDefinition",
      "g shift-o": "outline::Toggle",
      "g shift-w": "project_symbols::Toggle",

      "] c": "editor::GoToHunk",
      "[ c": "editor::GoToPreviousHunk",
      "space h s": "editor::ToggleSelectedDiffHunks",
      "space h r": "git::Restore",
      "space h p": "editor::ExpandAllDiffHunks",
      "space h i": "editor::ExpandAllDiffHunks",
      "space h b": "git::Blame",
      "space h d": "git::Diff",
      "space h shift-d": "git::Diff",
      "space h shift-s": "git::StageFile",
      "space h shift-r": "git::RestoreFile",
      "space t b": "editor::ToggleGitBlameInline",

      "space t t": "terminal_panel::Toggle",
      "space t n": "workspace::NewTerminal",

      "space a a": "agent::ToggleFocus",
      "space a n": "agent::NewThread",
      "space a i": "assistant::InlineAssist",
      "space a l": "agent::AddSelectionToThread"
    }
  },
  {
    "context": "Editor && (vim_mode == visual || vim_mode == visual_line || vim_mode == visual_block)",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
      "space p": "editor::Paste",
      "space y": "editor::Copy",
      "space d": "editor::Delete"
    }
  },
  {
    "context": "showing_completions",
    "bindings": {
      "ctrl-y": null,
      "ctrl-e": null
    }
  },
  {
    "context": "showing_completions",
    "bindings": {
      "ctrl-y": "editor::ConfirmCompletion",
      "ctrl-e": "editor::Cancel"
    }
  }
]
